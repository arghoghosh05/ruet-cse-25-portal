rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Approved profiles and academic resources are publicly readable
    match /profiles/{document} {
      allow read: if true;
      allow write: if false; // Managed securely via Server Actions (Firebase Admin SDK)
    }

    match /telegram_resources/{document} {
      allow read: if true;
      allow write: if false;
    }

    // Student account records and unverified submissions are private
    match /student_accounts/{document} {
      allow read, write: if false;
    }

    match /student_submissions/{document} {
      allow read, write: if false;
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
